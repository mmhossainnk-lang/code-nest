# Copy this file to .env.local and fill in your own values.
# Full Lemon Squeezy setup walkthrough: see SETUP.md in the project root.

# Your site's deployed URL (no trailing slash). Used for the sitemap,
# canonical links, and social-share (OG) image URLs. Defaults to
# http://localhost:3000 if unset — set this to your real domain in
# production (e.g. on Vercel, add it as an Environment Variable).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lemon Squeezy — get these after creating your store at https://app.lemonsqueezy.com

# Your store's subdomain, e.g. if your checkout URL is
# https://vaultix.lemonsqueezy.com/buy/... then this is "vaultix"
NEXT_PUBLIC_LEMONSQUEEZY_STORE_SUBDOMAIN=

# Settings → API → Create API key (server-side only, never expose with NEXT_PUBLIC_)
LEMONSQUEEZY_API_KEY=

# Settings → Webhooks → Signing secret (used to verify webhook requests)
LEMONSQUEEZY_WEBHOOK_SECRET=
